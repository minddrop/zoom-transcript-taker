# Server Configuration
PORT=3000
HOST=127.0.0.1

# Local Transcripts Save Directory
# Default: ./transcripts (relative to project directory)
# Or full Windows 11 path: C:\Users\YourName\Documents\ZoomTranscripts
TRANSCRIPTS_DIR=./transcripts

# Auto-Save Formats (comma-separated: md, txt, json, vtt)
AUTO_SAVE_FORMATS=md,txt,json,vtt

# Default Speech Recognition Language
DEFAULT_LANGUAGE=en-US

# Auto-Save Automatically When Leaving Room
AUTO_SAVE_ON_LEAVE=true
